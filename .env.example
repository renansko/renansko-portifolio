# Neon: copie a connection string em Project Dashboard > Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# OpenAI: chave usada apenas pelas funções serverless e pelo script de ingestão.
OPENAI_API_KEY=sk-...

# A aplicação solicita explicitamente embeddings com 1536 dimensões.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
